{
  "version": "0.1.0",
  "act_min_confidence": 0.8,
  "rules": [
    {
      "id": "LDA-LAYER",
      "label": "Domain must not import UI",
      "severity": "high",
      "confidence": 0.92,
      "from": "src/domain",
      "forbid_import_path": "src/ui"
    },
    {
      "id": "LDA-IMPORT",
      "label": "Domain must not import child_process",
      "severity": "high",
      "confidence": 0.9,
      "from": "src/domain",
      "forbid_module": "child_process"
    },
    {
      "id": "LDA-TEST",
      "label": "Source modules need a tests/ file",
      "severity": "medium",
      "confidence": 0.7,
      "source_glob": "src",
      "skip": ["index.js"]
    }
  ]
}
